# Example environment variables for AI configuration
# DO NOT store real secrets in the repository. Copy this to a local .env and set real keys there.

# GitHub API token (personal access token) used for GitHub API calls only
GITHUB_API_KEY=

# Local AI worker (Ollama) used by the Product Analyzer
MEETING_AI_WORKER_URL=http://127.0.0.1:8099
MEETING_AI_WORKER_TOKEN=
# Text model — for meeting summaries, chat, general text workloads (no vision).
# Recommended: qwen3:8b (fast Khmer summaries) or gemma3:4b or llama3.1:8b
OLLAMA_MODEL=qwen3:8b
# Vision model — MUST be a vision-capable Ollama model. Used by AI Product Analyzer.
# If OLLAMA_MODEL already contains "llava"/"bakllava"/"moondream"/"vision"/"-vl"/"pixtral"/"llama3.2-vision" it will be reused.
# Recommended (pull with `ollama pull <name>`):
#   - llava:7b          (good default vision accuracy on CPU/GPU)
#   - bakllava:7b       (faster than llava:7b)
#   - moondream:2b      (very fast, low RAM usage)
#   - qwen2.5-vl:7b     (very accurate vision; good with Khmer context)
#   - llama3.2-vision:11b  (very accurate, needs more RAM/VRAM)
OLLAMA_VISION_MODEL=llava:7b

# Model selection
AI_PUBLIC_MODEL=gemini-2.5-flash     # recommended for general public questions
AI_CODE_MODEL=gpt-4o                 # recommended for GitHub/code related tasks

# Toggle that blocks sending internal/private content to external LLMs
# When set to true, any request flagged as INTERNAL will be refused instead of forwarded.
BLOCK_INTERNAL_EXTERNAL=true

# Other keys (retain existing app keys but keep them local)
# OPENAI_API_KEY=  # if still used elsewhere, keep in local .env only
