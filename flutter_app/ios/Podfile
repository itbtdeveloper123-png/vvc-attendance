# Uncomment this line to define a global platform for your project
platform :ios, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# NOTE: ENV['EXCLUDED_ARCHS'] removed — it was excluding arm64 from iphoneos device builds.
# arm64 is ONLY excluded from iphonesimulator via post_install below.

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Required by permission_handler package for iOS
      # Without these macros, Permission.camera / location / etc. always returns
      # denied on iOS regardless of what the user has granted in Settings.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_LOCATION_WHEN_IN_USE=1',
        'PERMISSION_LOCATION_ALWAYS=1',
        'PERMISSION_PHOTOS=1',
      ]

      # Disable code signing for CI/CD unsigned builds
      if ENV['CI'] == 'true' || ENV['FLUTTER_NO_CODESIGN'] == 'true'
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGN_ENTITLEMENTS'] = ''
        config.build_settings['DEVELOPMENT_TEAM'] = ''
        config.build_settings['PROVISIONING_PROFILE'] = ''
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      end

      # Fix for Google ML Kit — ONLY exclude arm64 from SIMULATOR (not iphoneos device builds!)
      # google_mlkit_face_detection 0.14.0 + mobile_scanner 7.4.0 require this
      if target.name.start_with?('GoogleMLKit') || target.name.start_with?('MLKit') || target.name.start_with?('MLImage')
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      end

      # Fix for Google Maps SDK
      if target.name.start_with?('GoogleMaps') || target.name == 'GoogleMaps'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
      end

      # Fix for printing package — known iOS build issues with mixed ObjC/Swift
      if target.name == 'printing'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      end

      # Unified deployment target — 17.0 required by google_mlkit_commons 0.12.0
      # (MLKitCommon 10.x requires iOS 17.0 minimum as of 2025-2026)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end